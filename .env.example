# Copy this file to .env and fill in your own values. Never commit the real .env.

# --- QuickBooks Online (Intuit Developer sandbox) ---
QBO_CLIENT_ID=your_intuit_client_id
QBO_CLIENT_SECRET=your_intuit_client_secret
QBO_ENVIRONMENT=sandbox
QBO_COMPANY_ID=your_company_realm_id

# --- OpenAI (invoice extraction) ---
OPENAI_API_KEY=your_openai_api_key

# --- Google (Gmail intake + Google Sheets register/audit log) ---
# OAuth client created in Google Cloud Console; used by the n8n Gmail and Sheets credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Google Sheet that holds the "register" and "audit_log" tabs
INVOICE_REGISTER_SHEET_ID=your_google_sheet_id

# Dedicated accounts-payable inbox (not a personal address)
AP_INBOX_EMAIL=ap-inbox@example.com
AP_REVIEW_EMAIL=ap-review@example.com
