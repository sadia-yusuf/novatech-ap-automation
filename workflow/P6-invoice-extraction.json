    {
      "parameters": {
        "jsCode": "// Day 3 – Controls: vendor match, duplicates, footing, dates, period & capex review, approval limit\n// Mode: Run Once for All Items\nconst CONFIG = {\n  AS_OF: '2026-02-28',        // processing date for the NovaTech simulation (Feb 2026 AP run)\n  APPROVAL_LIMIT: 2500,       // invoices above this need approval\n  MAX_AGE_DAYS: 90,           // older invoices are flagged as stale\n  POSSIBLE_DUP_DAYS: 30,      // same vendor + same amount within this window = possible duplicate\n  CAPEX_MIN: 1000,            // NovaTech capitalisation threshold\n  CAPEX_WORDS: ['laptop', 'computer', 'macbook', 'server', 'monitor', 'printer', 'desk', 'chair', 'furniture'],\n};\n\n// ---------- helpers ----------\nconst norm = s => String(s || '').toLowerCase()\n  .replace(/&/g, ' and ')\n  .replace(/[^a-z0-9 ]/g, ' ')\n  .replace(/\\b(inc|llc|ltd|limited|co|corp|corporation|company|the)\\b/g, ' ')\n  .replace(/\\s+/g, ' ').trim();\nconst normNo = s => String(s || '').toUpperCase().replace(/[^A-Z0-9]/g, '');\nconst daysBetween = (a, b) => Math.round((new Date(a) - new Date(b)) / 86400000);\nconst firstDate = s => (String(s || '').match(/\\d{4}-\\d{2}-\\d{2}/) || [null])[0];\n\n// ---------- 1. Vendor master (QuickBooks) ----------\nconst vendors = $('QBO vendors').all()\n  .map(v => ({ id: String(v.json.Id), name: v.json.DisplayName, key: norm(v.json.DisplayName) }))\n  .filter(v => v.key);\n\nfunction matchVendor(name) {\n  const k = norm(name);\n  if (!k) return null;\n  return vendors.find(v => v.key === k)                                            // exact\n      || vendors.find(v => v.key.startsWith(k + ' ') || k.startsWith(v.key + ' ')) // e.g. \"Slack\" ↔ \"Slack Technologies\"\n      || null;\n}\nconst vendorKey = name => { const m = matchVendor(name); return m ? m.id : 'raw:' + norm(name); };\n\n// ---------- 2. Invoices already in the register + this batch ----------\nconst history = $('Read register').all().map(r => r.json).filter(r => r.invoice_number);\nconst batch   = $('Code in JavaScript').all().map(i => i.json);\nconst seen = history.map(r => ({\n  vk: vendorKey(r.vendor_name), no: normNo(r.invoice_number),\n  total: Number(r.stated_total), date: r.invoice_date, file: r.source_file,\n}));\nconst runAt = new Date().toISOString();\n\n// ---------- 3. Apply controls to each invoice ----------\nreturn batch.map(inv => {\n  const blocking = [], notes = [];\n  let hold = false, needsApproval = false;\n\n  // Vendor master match\n  const v = matchVendor(inv.vendor_name);\n  if (!v) blocking.push('UNKNOWN_VENDOR');\n  else if (norm(v.name) !== norm(inv.vendor_name)) notes.push(`VENDOR_MATCHED_TO: ${v.name}`);\n  const vk = v ? v.id : 'raw:' + norm(inv.vendor_name);\n  const no = normNo(inv.invoice_number);\n  const total = Number(inv.stated_total);\n\n  // Duplicates (against register history AND earlier invoices in this batch)\n  const exact = seen.find(s => s.vk === vk && s.no && s.no === no);\n  if (exact) {\n    blocking.push(`EXACT_DUPLICATE of ${exact.file || exact.no}`);\n  } else {\n    const possible = seen.find(s => s.vk === vk && s.no !== no &&\n      Math.abs(s.total - total) < 0.01 &&\n      Math.abs(daysBetween(s.date, inv.invoice_date)) <= CONFIG.POSSIBLE_DUP_DAYS);\n    if (possible) blocking.push(`POSSIBLE_DUPLICATE of ${possible.file || possible.no}`);\n  }\n  seen.push({ vk, no, total, date: inv.invoice_date, file: inv.source_file });\n\n  // Footing and data quality (from Day 2 checks)\n  if (inv.footing_ok === false || String(inv.footing_ok).toUpperCase() === 'FALSE')\n    blocking.push(`FOOTING_MISMATCH (diff ${inv.footing_diff})`);\n  if (/MISSING_|BAD_DATE|NO_LINE/.test(inv.flags || '')) blocking.push('DATA_QUALITY');\n\n  // Date sanity\n  if (inv.invoice_date) {\n    const age = daysBetween(CONFIG.AS_OF, inv.invoice_date);\n    if (age < 0) blocking.push('FUTURE_DATED');\n    else if (age > CONFIG.MAX_AGE_DAYS) blocking.push(`STALE_INVOICE (${age} days)`);\n  }\n\n  // Service in an earlier month → cut-off / accrual review\n  const svcStart = firstDate(inv.service_period);\n  if (svcStart && inv.invoice_date && svcStart.slice(0, 7) < inv.invoice_date.slice(0, 7)) {\n    hold = true;\n    notes.push(`SERVICE_PERIOD_REVIEW: service from ${svcStart} – check prior-period accrual`);\n  }\n\n  // Capex indicator\n  let lines = [];\n  try { lines = JSON.parse(inv.lines_json || '[]'); } catch (e) {}\n  const capexAmt = lines\n    .filter(l => CONFIG.CAPEX_WORDS.some(w => String(l.description || '').toLowerCase().includes(w)))\n    .reduce((s, l) => s + Number(l.amount || 0), 0);\n  if (capexAmt >= CONFIG.CAPEX_MIN)\n    notes.push(`CAPEX_REVIEW: ${capexAmt.toFixed(2)} on asset lines – check capitalisation (incl. freight)`);\n\n  // Approval limit\n  if (total > CONFIG.APPROVAL_LIMIT) {\n    needsApproval = true;\n    notes.push(`OVER_APPROVAL_LIMIT (${CONFIG.APPROVAL_LIMIT})`);\n  }\n  if ((inv.flags || '').includes('CURRENCY_DEFAULTED')) notes.push('CURRENCY_DEFAULTED_USD');\n\n  const status = blocking.length ? 'EXCEPTION'\n               : hold ? 'HOLD'\n               : needsApproval ? 'NEEDS_APPROVAL'\n               : 'READY';\n\n  return { json: {\n    ...inv,\n    qbo_vendor_id:    v ? v.id : '',\n    qbo_vendor_name:  v ? v.name : '',\n    status,\n    exception_reason: blocking.join(' | '),\n    review_notes:     notes.join(' | '),\n    controls_run_at:  runAt,\n  }};\n});"
      },
