    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Part C – normalise AI output and run arithmetic checks (rules, not AI)\n// Mode: Run Once for Each Item\nconst o = $json.output;\nconst src = $('Normalise intake').item.json;          // intake metadata (form or email)\nconst round2 = n => Math.round((Number(n) || 0) * 100) / 100;\n\n// Clean line items\nconst lines = (o.line_items || []).map(l => ({\n  description: l.description,\n  qty: l.qty,\n  unit_price: l.unit_price,\n  amount: round2(l.amount),\n}));\n\n// Footing check: lines + tax must equal the stated total\nconst linesSum    = round2(lines.reduce((s, l) => s + l.amount, 0));\nconst tax         = round2(o.tax);\nconst statedTotal = round2(o.total);\nconst footingDiff = round2(statedTotal - (linesSum + tax));\n\n// Flags (record problems – never fix them)\nconst flags = [];\nif (Math.abs(footingDiff) > 0.01) flags.push(`FOOTING_MISMATCH: lines+tax ${round2(linesSum + tax)} vs stated ${statedTotal}`);\nif (!o.invoice_number) flags.push('MISSING_INVOICE_NUMBER');\nif (!o.invoice_date)   flags.push('MISSING_INVOICE_DATE');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(o.invoice_date || '')) flags.push('BAD_DATE_FORMAT');\nif (lines.length === 0) flags.push('NO_LINE_ITEMS');\n\nlet currency = o.currency;\nif (!currency) { currency = 'USD'; flags.push('CURRENCY_DEFAULTED_USD'); }\n\n// Output – field names match the Google Sheet headers exactly\nreturn {\n  received_at:      src.received_at,\n  source_channel:   src.source_channel,\n  email_from:       src.email_from,\n  email_subject:    src.email_subject,\n  email_message_id: src.email_message_id,\n  source_file:      src.source_file,\n  vendor_name:      o.vendor_name,\n  invoice_number:   o.invoice_number,\n  invoice_date:     o.invoice_date,\n  due_date:         o.due_date,\n  service_period:   o.service_period,\n  currency,\n  line_count:       lines.length,\n  lines_sum:        linesSum,\n  tax,\n  stated_total:     statedTotal,\n  footing_diff:     footingDiff,\n  footing_ok:       Math.abs(footingDiff) <= 0.01,\n  flags:            flags.join(' | '),\n  lines_json:       JSON.stringify(lines),\n  extracted_at:     new Date().toISOString(),\n};"
      },
