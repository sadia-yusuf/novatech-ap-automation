      "parameters": {
        "jsCode": "// Normalise intake – one item per PDF, same shape for every channel\nconst out = [];\n$input.all().forEach((item, i) => {\n  const j = item.json, bin = item.binary || {};\n\n  if (j.submittedAt) {                       // came from the upload form\n    out.push({\n      json: { source_channel: 'form', source_file: j.invoice?.filename,\n              email_from: null, email_subject: null, email_message_id: null,\n              received_at: j.submittedAt },\n      binary: { invoice: bin.invoice },\n      pairedItem: { item: i },\n    });\n    return;\n  }\n\n  for (const key of Object.keys(bin)) {      // came from Gmail – one item per PDF\n    const f = bin[key];\n    if (f.mimeType !== 'application/pdf') continue;\n    out.push({\n      json: { source_channel: 'email', source_file: f.fileName,\n              email_from: j.from?.value?.[0]?.address || j.from?.text || null,\n              email_subject: j.subject || null,\n              email_message_id: j.id || null,\n              received_at: j.date || new Date().toISOString() },\n      binary: { invoice: f },\n      pairedItem: { item: i },\n    });\n  }\n});\nreturn out;"
      },
