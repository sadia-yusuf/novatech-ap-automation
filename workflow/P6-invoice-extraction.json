        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #e0e0e0; border-radius: 8px;\">\n  \n  <h2 style=\"color: #d9534f; border-bottom: 2px solid #d9534f; padding-bottom: 10px;\">\n    ⚠️ AP Review Required\n  </h2>\n\n  <p style=\"color: #333;\">An invoice has been flagged and requires your review before processing.</p>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin: 20px 0;\">\n    <tr style=\"background-color: #f9f9f9;\">\n      <td style=\"padding: 10px; border: 1px solid #ddd; font-weight: bold; width: 40%;\">Invoice Number</td>\n      <td style=\"padding: 10px; border: 1px solid #ddd;\">{{ $input.item.json.invoice_number }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid #ddd; font-weight: bold;\">Vendor</td>\n      <td style=\"padding: 10px; border: 1px solid #ddd;\">{{ $input.item.json.vendor_name }}</td>\n    </tr>\n    <tr style=\"background-color: #f9f9f9;\">\n      <td style=\"padding: 10px; border: 1px solid #ddd; font-weight: bold;\">Amount</td>\n      <td style=\"padding: 10px; border: 1px solid #ddd;\">{{ $input.item.json.currency }} {{ $input.item.json.total_amount }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid #ddd; font-weight: bold;\">Invoice Date</td>\n      <td style=\"padding: 10px; border: 1px solid #ddd;\">{{ $input.item.json.invoice_date }}</td>\n    </tr>\n    <tr style=\"background-color: #f9f9f9;\">\n      <td style=\"padding: 10px; border: 1px solid #ddd; font-weight: bold;\">Status</td>\n      <td style=\"padding: 10px; border: 1px solid #ddd;\">{{ $input.item.json.status }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid #ddd; font-weight: bold;\">Reason for Review</td>\n      <td style=\"padding: 10px; border: 1px solid #ddd; color: #d9534f;\">{{ $input.item.json.exception_reason }}</td>\n    </tr>\n  </table>\n\n  <p style=\"color: #666; font-