    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Map vendor + line items -> GL expense account for the QBO bill\n// Runs only on the READY branch. First matching rule wins; unknown -> Uncategorized.\nconst inv = $json;\nconst vendor = String(inv.qbo_vendor_name || inv.vendor_name || '').toLowerCase();\nlet lines = [];\ntry { lines = JSON.parse(inv.lines_json || '[]'); } catch (e) {}\nconst lineText = lines.map(l => String(l.description || '')).join(' ').toLowerCase();\nconst hay = vendor + ' ' + lineText;\n\n// NovaTech chart of accounts - expense accounts (QBO Ids)\nconst ACCT = {\n  software:  { id: '1150040037', name: 'Software Subscriptions' },\n  cloud:     { id: '1150040038', name: 'Cloud Hosting – Internal' },\n  utilities: { id: '1150040036', name: 'Utilities & Internet' },\n  travel:    { id: '112',        name: 'Travel' },\n  meals:     { id: '113',        name: 'Travel Meals' },\n  marketing: { id: '97',         name: 'Marketing & Advertising' },\n  acctgTax:  { id: '1150040040', name: 'Accounting & Tax Fees' },\n  legal:     { id: '1150040039', name: 'Legal Fees' },\n  office:    { id: '110',        name: 'Office Supplies & Small Equipment' },\n  taxesLic:  { id: '1150040048', name: 'Taxes & Licenses' },\n  bankFees:  { id: '98',         name: 'Bank Charges' },\n  insurance: { id: '101',        name: 'Insurance' },\n  rent:      { id: '1150040035', name: 'Rent' },\n  uncat:     { id: '124',        name: 'Uncategorized Expense' },\n};\n\n// Keyword rules, first match wins\nconst RULES = [\n  [/slack|hubspot|zoom|microsoft|google workspace|adobe|notion|atlassian|dropbox|subscription|software|licen[cs]e/, ACCT.software],\n  [/aws|amazon web|azure|gcp|google cloud|cloud hosting|hosting|server|digitalocean/, ACCT.cloud],\n  [/comcast|verizon|at&t|internet|broadband|utilit|electric|water|phone|telecom/, ACCT.utilities],\n  [/airfare|flight|hotel|airline|booking|skyward|travel/, ACCT.travel],\n  [/meal|restaurant|catering|dining/, ACCT.meals],\n  [/marketing|advertis|google ads|facebook ads|linkedin ads|campaign/, ACCT.marketing],\n  [/accounting|audit|bookkeep|\\bcpa\\b|tax prep/, ACCT.acctgTax],\n  [/legal|attorney|law firm|counsel/, ACCT.legal],\n  [/office suppl|stationery|equipment|printer|toner/, ACCT.office],\n  [/delaware division|franchise tax|secretary of state|registration|filing fee|\\blicense\\b/, ACCT.taxesLic],\n  [/bank charge|wire fee|processing fee|stripe|merchant fee/, ACCT.bankFees],\n  [/insurance|premium/, ACCT.insurance],\n  [/\\brent\\b|lease|landlord/, ACCT.rent],\n];\n\nlet acct = ACCT.uncat;\nfor (const [re, a] of RULES) { if (re.test(hay)) { acct = a; break; } }\n\nreturn { ...inv, qbo_account_id: acct.id, qbo_account_name: acct.name };"
      },
